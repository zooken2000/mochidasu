{
  "name": "@mochidasu/web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/web/src",
  "projectType": "application",
  "tags": [],
  "metadata": {
    "ports": [4200],
    "generator": "ts#react-website",
    "ux": "shadcn",
    "framework": "react",
    "infra": "cloudfront-s3",
    "tailwind": true,
    "tanstackRouter": true,
    "iac": "cdk",
    "components": [
      {
        "generator": "ts#react-website#runtime-config",
        "path": "src/components/RuntimeConfig"
      },
      {
        "generator": "ts#react-website#auth",
        "path": "src/components/CognitoAuth",
        "iac": "cdk"
      },
      {
        "generator": "py#agent#react-connection",
        "path": "src/components/ExtractorProvider",
        "name": "Extractor",
        "protocol": "http",
        "auth": "cognito",
        "theme": "shadcn"
      }
    ]
  },
  "targets": {
    "assemble": {
      "dependsOn": ["compile", "bundle"]
    },
    "build": {
      "dependsOn": ["lint", "compile", "test", "bundle"]
    },
    "bundle": {
      "dependsOn": ["generate:extractor-client"]
    },
    "compile": {
      "dependsOn": ["^compile", "generate:extractor-client"],
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/tsc"],
      "options": {
        "command": "tsc --build tsconfig.app.json",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["mochidasu.agent"],
          "target": "extractor-dev"
        },
        "generate:extractor-client",
        "watch-generate:extractor-client"
      ],
      "continuous": true,
      "options": {
        "command": "vite --mode local-dev",
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "options": {
        "command": "biome format {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome format --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "generate:extractor-client": {
      "executor": "@aws/nx-plugin:open-api-codegen",
      "dependsOn": ["mochidasu.agent:extractor-openapi"],
      "cache": true,
      "inputs": [
        {
          "dependentTasksOutputFiles": "**/*.json"
        }
      ],
      "outputs": ["{workspaceRoot}/packages/web/src/generated/extractor"],
      "options": {
        "generator": "ts-hooks",
        "openApiSpecPath": "dist/packages/agent/openapi/extractor/openapi.json",
        "outputPath": "packages/web/src/generated/extractor"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "dependsOn": ["format"],
      "options": {
        "command": "biome lint {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome check --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "load-runtime-config": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Load runtime config from your deployed stack for dev purposes. You must set your AWS CLI credentials whilst calling 'pnpm nx load-runtime-config @mochidasu/web'"
      },
      "options": {
        "command": "aws s3 cp s3://`aws cloudformation describe-stacks --query \"Stacks[?starts_with(StackName, 'mochidasu-')][].Outputs[] | [?contains(OutputKey, 'WebWebsiteBucketName')].OutputValue\" --output text`/runtime-config.json \"{projectRoot}/public/runtime-config.json\""
      }
    },
    "watch-generate:extractor-client": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "commands": [
          "nx watch --projects=mochidasu.agent --includeDependencies -- nx run @mochidasu/web:\"generate:extractor-client\""
        ]
      }
    }
  }
}
