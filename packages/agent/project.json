{
  "name": "mochidasu.agent",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/agent/mochidasu_agent",
  "release": {
    "version": {
      "versionActions": "@nxlv/python/release/version-actions"
    }
  },
  "tags": [],
  "metadata": {
    "generator": "py#project",
    "ports": [8081],
    "components": [
      {
        "generator": "py#agent",
        "path": "mochidasu_agent/extractor",
        "name": "extractor",
        "infra": "agentcore",
        "port": 8081,
        "rc": "Extractor",
        "auth": "cognito",
        "protocol": "http",
        "framework": "strands",
        "session": "s3",
        "iac": "cdk"
      }
    ]
  },
  "targets": {
    "add": {
      "executor": "@nxlv/python:add",
      "options": {}
    },
    "assemble": {
      "dependsOn": ["compile", "bundle", "extractor-package"]
    },
    "build": {
      "dependsOn": [
        "lint",
        "compile",
        "test",
        "typecheck",
        "bundle",
        "extractor-package"
      ],
      "inputs": ["default", "^production"],
      "options": {
        "outputPath": "{workspaceRoot}/dist/{projectRoot}"
      }
    },
    "bundle": {
      "dependsOn": ["bundle-arm"]
    },
    "bundle-arm": {
      "executor": "nx:run-commands",
      "dependsOn": ["compile"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/bundle-arm"],
      "options": {
        "commands": [
          "uv export --frozen --no-dev --no-editable --project {projectRoot} --package mochidasu.agent -o dist/{projectRoot}/bundle-arm/requirements.txt",
          "uv pip install -n --no-deps --no-installer-metadata --no-compile-bytecode --python-platform aarch64-manylinux_2_28 --python-version 3.14 --target dist/{projectRoot}/bundle-arm -r dist/{projectRoot}/bundle-arm/requirements.txt"
        ],
        "parallel": false
      }
    },
    "compile": {
      "executor": "@nxlv/python:build",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "options": {
        "outputPath": "{workspaceRoot}/dist/{projectRoot}/build",
        "publish": false,
        "lockedVersions": true,
        "bundleLocalDependencies": true,
        "ignorePaths": [
          ".venv",
          ".tox",
          "tests",
          "__pycache__",
          ".coverage",
          ".coverage.*",
          ".pytest_cache",
          "pytest-cache-files-*",
          ".ruff_cache"
        ]
      }
    },
    "dev": {
      "dependsOn": ["extractor-dev"],
      "continuous": true
    },
    "extractor-chat": {
      "executor": "nx:run-commands",
      "dependsOn": ["extractor-generate-client"],
      "options": {
        "commands": ["tsx ./scripts/extractor/chat.ts"],
        "cwd": "{projectRoot}",
        "env": {
          "URL": "http://localhost:8081"
        }
      }
    },
    "extractor-dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "commands": [
          "uv run fastapi dev mochidasu_agent/extractor/main.py --port 8081"
        ],
        "cwd": "{projectRoot}",
        "env": {
          "PORT": "8081",
          "LOCAL_DEV": "true"
        }
      }
    },
    "extractor-generate-client": {
      "executor": "@aws/nx-plugin:open-api-codegen",
      "dependsOn": ["extractor-openapi"],
      "cache": true,
      "inputs": [
        {
          "dependentTasksOutputFiles": "**/*.json"
        }
      ],
      "outputs": ["{projectRoot}/scripts/extractor/generated"],
      "options": {
        "generator": "ts-client",
        "openApiSpecPath": "dist/packages/agent/openapi/extractor/openapi.json",
        "outputPath": "packages/agent/scripts/extractor/generated"
      }
    },
    "extractor-openapi": {
      "cache": true,
      "inputs": ["production", "^production"],
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/openapi/extractor"],
      "options": {
        "commands": [
          "uv run python {projectRoot}/scripts/extractor_openapi.py \"dist/{projectRoot}/openapi/extractor/openapi.json\""
        ]
      }
    },
    "extractor-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["bundle-arm"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/dist/packages/agent/package/extractor"],
      "options": {
        "commands": [
          "shx rm -rf dist/packages/agent/package/extractor",
          "shx mkdir -p dist/packages/agent/package/extractor",
          "shx cp -R dist/packages/agent/bundle-arm/. dist/packages/agent/package/extractor",
          "shx cp -R packages/agent/mochidasu_agent/. dist/packages/agent/package/extractor/mochidasu_agent",
          "shx cp packages/agent/package/extractor/main.py dist/packages/agent/package/extractor/main.py"
        ],
        "parallel": false
      }
    },
    "extractor-serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "commands": [
          "uv run fastapi dev mochidasu_agent/extractor/main.py --port 8081"
        ],
        "cwd": "{projectRoot}",
        "env": {
          "PORT": "8081"
        }
      }
    },
    "format": {
      "executor": "@nxlv/python:ruff-format",
      "outputs": [],
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "filePatterns": ["mochidasu_agent", "tests"],
        "check": true
      },
      "configurations": {
        "fix": {
          "check": false
        },
        "skip-lint": {
          "check": false
        }
      }
    },
    "install": {
      "executor": "@nxlv/python:install",
      "options": {
        "silent": false,
        "args": "",
        "verbose": false,
        "debug": false
      }
    },
    "lint": {
      "executor": "@nxlv/python:ruff-check",
      "dependsOn": ["format"],
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": [],
      "options": {
        "lintFilePatterns": ["mochidasu_agent", "tests"]
      },
      "configurations": {
        "fix": {
          "fix": true
        },
        "skip-lint": {
          "exitZero": true
        }
      }
    },
    "lock": {
      "executor": "@nxlv/python:lock",
      "options": {
        "update": false
      }
    },
    "remove": {
      "executor": "@nxlv/python:remove",
      "options": {}
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {}
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "outputs": [
        "{workspaceRoot}/reports/{projectRoot}/unittests",
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "cache": true,
      "options": {
        "command": "uv run pytest tests/",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^production"],
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run ty check",
        "cwd": "{projectRoot}"
      }
    },
    "update": {
      "executor": "@nxlv/python:update",
      "options": {}
    }
  }
}
